---
import { getCollection } from 'astro:content';
import { CardGrid, LinkCard } from '@astrojs/starlight/components';

// One card per `projects/<name>/introduction` page, so a new project shows up
// here automatically once it has an introduction page.
const projects = (
	await getCollection('docs', ({ id }) => /^projects\/[^/]+\/introduction$/.test(id))
).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<CardGrid>
	{
		projects.map(({ id, data }) => (
			<LinkCard title={data.title} description={data.description} href={`/${id}/`} />
		))
	}
</CardGrid>
